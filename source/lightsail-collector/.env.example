# Copy to /etc/home-energy-ws-collector/environment and chmod 600.
# Never commit real values or put them into a deployment ZIP.
FOXESS_EMAIL=you@example.com
FOXESS_PASSWORD_MD5=replace_with_lowercase_md5_of_web_password
# Required when the account has more than one plant; recommended in production.
FOXESS_PLANT_ID=
FOXESS_SIGNATURE_WASM=/etc/home-energy-ws-collector/signature.wasm

TELEMETRY_TABLE_NAME=home-energy-telemetry
SITE_ID=home
AWS_REGION=ap-southeast-2
AWS_SHARED_CREDENTIALS_FILE=/etc/home-energy-ws-collector/aws-credentials

DISPLAY_TIMEZONE=Australia/Melbourne
FRESH_TIMEDIFF_MAX=30
STALE_AFTER_SECONDS=35
RECONNECT_AFTER_SECONDS=90
RECOVERY_PROBE_SECONDS=30
MAX_SESSION_SECONDS=480
WRITE_QUEUE_SIZE=512
HEALTH_WRITE_SECONDS=60
DEDUPE_CAPACITY=50000

# Confirmed by the supplied KH capture and the FoxESS WebSocket bridge model.
GRID_IMPORT_CODE=1
GRID_EXPORT_CODE=-1
BATTERY_CHARGE_CODE=1
BATTERY_DISCHARGE_CODE=2
DEBUG_FRAMES=false

